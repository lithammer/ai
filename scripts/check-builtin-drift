#!/usr/bin/env python3
"""Detect drift in the Claude Code built-in prompts that skills here port."""

import argparse
import difflib
import re
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SNAPSHOT_PATH = ROOT / "vendor" / "claude-code" / "prompts.md"
# The bundle renames its variables every release, so find each prompt
# template by its visible opening line instead. /simplify matches both of its
# variants; /code-review matches its extra-high tier.
ANCHORS = {
    "simplify": re.compile(r"`\\`/simplify \\u2192 "),
    "code-review": re.compile(r"`\\`\$\{[\w$]+\} effort \\u2192 5\+5 angles"),
}
INTERPOLATION = re.compile(r"\$\{(?:([\w$]+)|[^{}]*)\}")
CHUNK_HEADER = "// @bun"
# Imports, parameters, expressions, and names defined more than once render as
# a fixed placeholder, since their minified forms change every release. A
# fragment that turns into one still shows up, as text dropping out of its
# parent template. Text built by a function call, such as /code-review's
# output contract, never resolves, so its drift goes unseen.
PLACEHOLDER = "${...}"
ESCAPE = re.compile(r"\\(u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)", re.DOTALL)
ESCAPES = {"n": "\n", "t": "\t"}
CLI_EPILOG = """\
skills/simplify and skills/code-review port built-in prompts with deliberate
changes, so drift is measured against the built-in text they were last
synced from, not against the skills. When check reports a diff, port it into
the affected skill, then run update to record the new snapshot.

examples:
  scripts/check-builtin-drift
  scripts/check-builtin-drift update
"""


class Arguments(argparse.Namespace):
    command: str
    claude: Path | None


def literal_end(source: str, start: int, quote: str) -> int:
    """Return the index of the closing quote of a literal opened before start."""
    index = start
    while source[index] != quote:
        index += 2 if source[index] == "\\" else 1
    return index


def unescape(text: str) -> str:
    """Decode the JavaScript escapes the bundle uses in prompt text."""

    def decode(match: re.Match[str]) -> str:
        escape = match.group(1)
        if len(escape) > 1:
            return chr(int(escape[1:], 16))
        return ESCAPES.get(escape, escape)

    return ESCAPE.sub(decode, text)


def render(chunk: str, template: str) -> str:
    """Fill in a template's interpolations from definitions in its chunk."""

    def fill(match: re.Match[str]) -> str:
        name = match.group(1)
        return resolve(chunk, name) if name else PLACEHOLDER

    return INTERPOLATION.sub(fill, unescape(template))


def resolve(chunk: str, name: str) -> str:
    """Return the string literal a minified variable holds within its chunk."""
    definitions = list(re.finditer(rf"[\s,;]{re.escape(name)}=([`\"])", chunk))
    if len(definitions) != 1:
        return PLACEHOLDER
    start = definitions[0].end()
    quote = definitions[0].group(1)
    value = chunk[start : literal_end(chunk, start, quote)]
    return render(chunk, value) if quote == "`" else unescape(value)


def extract(binary: Path) -> str:
    """Render each ported built-in prompt."""
    source = binary.read_bytes().decode("utf-8", "replace")
    prompts = []
    for label, anchor in ANCHORS.items():
        matches = list(anchor.finditer(source))
        if not matches:
            raise SystemExit(
                f"no {label} prompt found in {binary}; "
                "its opening line likely changed, so update ANCHORS"
            )
        for match in matches:
            start = match.start() + 1
            template = source[start : literal_end(source, start, "`")]
            chunk_start = source.rfind(CHUNK_HEADER, 0, start)
            chunk_end = source.find(CHUNK_HEADER, start)
            chunk = source[chunk_start : chunk_end if chunk_end >= 0 else None]
            prompts.append(f"# {label}\n\n{render(chunk, template)}")
    return "\n---\n\n".join(prompts)


def find_claude() -> Path:
    """Return the real binary behind the claude on PATH."""
    found = shutil.which("claude")
    if found is None:
        raise SystemExit("claude is not on PATH; pass --claude")
    return Path(found).resolve()


def parse_args() -> Arguments:
    """Parse the command line."""
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog=CLI_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="check",
        choices=["check", "update"],
        help="check prints drift and exits 1; update rewrites the snapshot",
    )
    parser.add_argument(
        "--claude", type=Path, help="Claude Code binary; defaults to claude on PATH"
    )
    return parser.parse_args(namespace=Arguments())


def main() -> int:
    """Compare or record the built-in prompts."""
    args = parse_args()
    binary = args.claude or find_claude()
    current = extract(binary)

    if args.command == "update":
        SNAPSHOT_PATH.write_text(current)
        print(f"recorded {binary.name} in {SNAPSHOT_PATH.relative_to(ROOT)}")
        return 0

    snapshot = SNAPSHOT_PATH.read_text()
    if snapshot == current:
        print(f"no drift: {binary.name} matches the snapshot")
        return 0
    sys.stdout.writelines(
        difflib.unified_diff(
            snapshot.splitlines(keepends=True),
            current.splitlines(keepends=True),
            "snapshot",
            binary.name,
        )
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
