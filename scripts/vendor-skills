#!/usr/bin/env python3
"""Reproduce and update third-party skills checked into this repository."""

import argparse
import copy
import hashlib
import io
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
from collections.abc import Iterator
from collections.abc import Set as AbstractSet
from contextlib import ExitStack
from pathlib import Path
from typing import Final, Literal, NamedTuple, TypedDict, cast

ROOT = Path(os.environ.get("VENDOR_SKILLS_ROOT", Path(__file__).resolve().parents[1]))
MANIFEST_PATH = ROOT / "vendor" / "skills.json"
CACHE_ROOT = Path(
    os.environ.get(
        "VENDOR_SKILLS_CACHE",
        Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        / "lithammer-ai"
        / "vendor-skills",
    )
)
MANIFEST_VERSION: Final = 2
LOCK_FIELDS = ("outputSha256", "recipeSha256")
MANIFEST_FIELDS = {"version", "repositories", "skills"}
REPOSITORY_FIELDS = {"url", "branch", "revision"}
REQUIRED_ENTRY_FIELDS = {"repository", "source"}
OPTIONAL_ENTRY_FIELDS = {"license", "patches", *LOCK_FIELDS}
LICENSE_FIELDS = {"source", "destination"}
NAME_PATTERN = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
NAME_FIELD = re.compile(r"(?m)^name:\s*([^\n]+)$")
REVISION_PATTERN = re.compile(r"(?:[0-9a-f]{40}|[0-9a-f]{64})")
HASH_PATTERN = re.compile(r"[0-9a-f]{64}")
CLI_EPILOG = """\
Vendored skill directories are generated from vendor/skills.json. Edit the
manifest or patch files listed by its patches fields, then run sync; do not
edit a generated copy directly. Local names remain stable when upstream names change.
A missing upstream source fails before replacing the existing copy or pin.

examples:
  scripts/vendor-skills check
  scripts/vendor-skills sync self-review
  scripts/vendor-skills update
"""


class LicenseSpec(TypedDict):
    source: str
    destination: str


class RepositorySpec(TypedDict):
    url: str
    branch: str
    revision: str


class RequiredSkillEntry(TypedDict):
    repository: str
    source: str


class SkillEntry(RequiredSkillEntry, total=False):
    license: LicenseSpec
    patches: list[str]
    recipeSha256: str
    outputSha256: str


class Manifest(TypedDict):
    version: Literal[2]
    repositories: dict[str, RepositorySpec]
    skills: dict[str, SkillEntry]


SkillSelection = list[tuple[str, SkillEntry]]


class StagedSkill(NamedTuple):
    name: str
    directory: Path
    license: tuple[Path, Path] | None
    recipe_sha256: str
    output_sha256: str


Command = Literal["sync", "update", "check"]


class Arguments(argparse.Namespace):
    command: Command
    skills: list[str]
    force: bool


class VendorError(Exception):
    """An expected failure that main reports without a traceback."""


def require_mapping(value: object, context: str) -> dict[str, object]:
    """Require a JSON object with string keys."""
    if not isinstance(value, dict) or not all(isinstance(key, str) for key in value):
        raise VendorError(f"{context} must be an object with string keys")
    return cast(dict[str, object], value)


def validate_fields(
    value: dict[str, object],
    *,
    required: AbstractSet[str],
    optional: AbstractSet[str] = frozenset(),
    context: str,
) -> None:
    """Reject missing and unknown object fields."""
    missing = required - value.keys()
    if missing:
        raise VendorError(f"{context} is missing: {', '.join(sorted(missing))}")
    unknown = value.keys() - required - optional
    if unknown:
        raise VendorError(f"{context} has unknown fields: {', '.join(sorted(unknown))}")


def require_string(value: dict[str, object], field: str, context: str) -> str:
    """Require a non-empty string field."""
    item = value[field]
    if not isinstance(item, str) or not item:
        raise VendorError(f"{context}.{field} must be a non-empty string")
    return item


def validate_relative_path(path: str, field: str, prefix: str | None = None) -> None:
    """Require a portable relative repository path under an optional prefix."""
    parts = path.split("/")
    if (
        path.startswith("/")
        or "\\" in path
        or any(part in {"", ".", ".."} for part in parts)
    ):
        raise VendorError(f"{field} must be a safe relative path: {path!r}")
    prefix_parts = prefix.split("/") if prefix else []
    if prefix_parts and (
        parts[: len(prefix_parts)] != prefix_parts or len(parts) == len(prefix_parts)
    ):
        raise VendorError(f"{field} must be under {prefix}/: {path!r}")


def validate_license(value: object, context: str) -> None:
    """Validate the source and managed destination of a license."""
    entry = require_mapping(value, context)
    validate_fields(entry, required=LICENSE_FIELDS, context=context)
    source = require_string(entry, "source", context)
    destination = require_string(entry, "destination", context)
    validate_relative_path(source, f"{context}.source")
    validate_relative_path(destination, f"{context}.destination", "vendor/licenses")


def validate_skill_entry(
    name: str, raw_entry: object, repositories: dict[str, RepositorySpec]
) -> SkillEntry:
    """Validate one skill's source recipe and lock hashes."""
    if not NAME_PATTERN.fullmatch(name):
        raise VendorError(f"invalid manifest skill name: {name!r}")
    context = f"manifest.skills.{name}"
    entry = require_mapping(raw_entry, context)
    validate_fields(
        entry,
        required=REQUIRED_ENTRY_FIELDS,
        optional=OPTIONAL_ENTRY_FIELDS,
        context=context,
    )

    repository = require_string(entry, "repository", context)
    if repository not in repositories:
        raise VendorError(f"{context}.repository is unknown: {repository!r}")
    source = require_string(entry, "source", context)
    validate_relative_path(source, f"{context}.source")

    license_value = entry.get("license")
    if license_value is not None:
        validate_license(license_value, f"{context}.license")

    patches = entry.get("patches")
    if patches is not None:
        if not isinstance(patches, list) or not all(
            isinstance(patch, str) for patch in patches
        ):
            raise VendorError(f"{context}.patches must be a list of paths")
        if len(patches) != len(set(patches)):
            raise VendorError(f"{context}.patches contains duplicates")
        for patch in patches:
            validate_relative_path(patch, f"{context}.patches", "vendor/patches")

    hashes = {field: entry.get(field) for field in LOCK_FIELDS}
    count = sum(value is not None for value in hashes.values())
    if count not in (0, len(LOCK_FIELDS)):
        raise VendorError(f"{context} must declare both lock hashes or neither")
    for field, value in hashes.items():
        if value is not None and (
            not isinstance(value, str) or not HASH_PATTERN.fullmatch(value)
        ):
            raise VendorError(f"{context}.{field} must be a SHA-256 digest")

    return cast(SkillEntry, dict(entry))


def validate_manifest(value: object) -> Manifest:
    """Validate and return the complete version 2 manifest schema."""
    manifest = require_mapping(value, "manifest")
    validate_fields(manifest, required=MANIFEST_FIELDS, context="manifest")
    if manifest["version"] != MANIFEST_VERSION:
        raise VendorError(f"manifest.version must be {MANIFEST_VERSION}")

    raw_repositories = require_mapping(
        manifest["repositories"], "manifest.repositories"
    )
    repositories: dict[str, RepositorySpec] = {}
    for alias, raw_repository in raw_repositories.items():
        if not NAME_PATTERN.fullmatch(alias):
            raise VendorError(f"invalid manifest repository name: {alias!r}")
        context = f"manifest.repositories.{alias}"
        repository = require_mapping(raw_repository, context)
        validate_fields(repository, required=REPOSITORY_FIELDS, context=context)
        require_string(repository, "url", context)
        require_string(repository, "branch", context)
        revision = require_string(repository, "revision", context)
        if not REVISION_PATTERN.fullmatch(revision):
            raise VendorError(f"{context}.revision must be a full Git object ID")
        repositories[alias] = cast(RepositorySpec, dict(repository))

    skills = require_mapping(manifest["skills"], "manifest.skills")
    entries: dict[str, SkillEntry] = {}
    license_destinations: dict[Path, str] = {}
    for name, raw_entry in skills.items():
        entry = validate_skill_entry(name, raw_entry, repositories)
        license_entry = entry.get("license")
        if license_entry:
            destination = Path(license_entry["destination"])
            for other_destination, other_skill in license_destinations.items():
                if destination.is_relative_to(
                    other_destination
                ) or other_destination.is_relative_to(destination):
                    raise VendorError(
                        f"manifest.skills.{name}.license.destination overlaps skill "
                        f"{other_skill!r}"
                    )
            license_destinations[destination] = name
        entries[name] = entry

    used_repositories = {entry["repository"] for entry in entries.values()}
    unused = repositories.keys() - used_repositories
    if unused:
        raise VendorError(
            f"manifest.repositories are unused: {', '.join(sorted(unused))}"
        )

    return Manifest(version=MANIFEST_VERSION, repositories=repositories, skills=entries)


def run(*args: str, cwd: Path | None = None, stdin: bytes | None = None) -> bytes:
    """Run a subprocess and return its standard output."""
    try:
        return subprocess.run(
            args,
            cwd=cwd,
            input=stdin,
            capture_output=True,
            check=True,
        ).stdout
    except FileNotFoundError as error:
        raise VendorError(f"required command not found: {args[0]}") from error
    except subprocess.CalledProcessError as error:
        detail = error.stderr.decode(errors="replace").strip()
        raise VendorError(f"{' '.join(args)} failed: {detail}") from error


def load_manifest() -> Manifest:
    """Load and validate the vendoring manifest."""
    try:
        manifest: object = json.loads(MANIFEST_PATH.read_text())
    except FileNotFoundError as error:
        raise VendorError(f"manifest not found: {MANIFEST_PATH}") from error
    except json.JSONDecodeError as error:
        raise VendorError(f"invalid JSON in {MANIFEST_PATH}: {error}") from error
    return validate_manifest(manifest)


def manifest_contents(manifest: Manifest) -> str:
    """Validate and serialize the manifest in its canonical JSON format."""
    validated = validate_manifest(manifest)
    return json.dumps(validated, indent=2) + "\n"


def selected_skills(manifest: Manifest, names: list[str]) -> SkillSelection:
    """Select named skills, or every skill when no names are given."""
    skills = manifest["skills"]
    if not names:
        return list(skills.items())

    missing = [name for name in names if name not in skills]
    if missing:
        raise VendorError(f"unknown skill(s): {', '.join(missing)}")
    return [(name, skills[name]) for name in names]


def skill_destination(name: str) -> Path:
    """Return the managed destination for a local skill name."""
    return ROOT / "skills" / name


def group_skills(skills: SkillSelection) -> dict[str, SkillSelection]:
    """Group selected skills by repository while preserving manifest order."""
    groups: dict[str, SkillSelection] = {}
    for name, entry in skills:
        groups.setdefault(entry["repository"], []).append((name, entry))
    return groups


def cache_path(repository: RepositorySpec) -> Path:
    """Return the stable cache path for an upstream repository."""
    key = hashlib.sha256(repository["url"].encode()).hexdigest()[:16]
    return CACHE_ROOT / key


def ensure_checkout(repository: RepositorySpec, *, fetch: bool) -> Path:
    """Create the bare checkout and optionally fetch its tracking branch."""
    url = repository["url"]
    checkout = cache_path(repository)
    CACHE_ROOT.mkdir(parents=True, exist_ok=True)

    if not checkout.exists():
        run("git", "clone", "--bare", url, str(checkout))
    if fetch:
        branch = repository["branch"]
        run(
            "git",
            "-C",
            str(checkout),
            "fetch",
            "--force",
            "--prune",
            "origin",
            f"+refs/heads/{branch}:refs/remotes/origin/{branch}",
        )
    return checkout


def has_revision(checkout: Path, revision: str) -> bool:
    """Return whether a checkout contains the requested commit."""
    result = subprocess.run(
        ["git", "-C", str(checkout), "cat-file", "-e", f"{revision}^{{commit}}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def ensure_revision(repository: RepositorySpec) -> Path:
    """Return a checkout containing the pinned revision."""
    checkout = ensure_checkout(repository, fetch=False)
    if has_revision(checkout, repository["revision"]):
        return checkout

    checkout = ensure_checkout(repository, fetch=True)
    if has_revision(checkout, repository["revision"]):
        return checkout
    raise VendorError(
        f"revision not found for {repository['url']}: {repository['revision']}"
    )


def resolve_revision(repository: RepositorySpec) -> str:
    """Resolve a repository's tracking branch to a commit."""
    branch = repository["branch"]
    checkout = ensure_checkout(repository, fetch=True)
    remote_branch = f"refs/remotes/origin/{branch}"
    resolved = run(
        "git", "-C", str(checkout), "rev-parse", f"{remote_branch}^{{commit}}"
    )
    return resolved.decode().strip()


def safe_extract(archive: bytes, destination: Path) -> None:
    """Extract a tar archive after rejecting paths outside the destination."""
    destination = destination.resolve()
    with tarfile.open(fileobj=io.BytesIO(archive), mode="r:") as tar:
        for member in tar.getmembers():
            target = (destination / member.name).resolve()
            if target != destination and destination not in target.parents:
                raise VendorError(f"unsafe path in git archive: {member.name}")
        tar.extractall(destination)


def source_directory_exists(checkout: Path, revision: str, source: str) -> bool:
    """Return whether an upstream revision contains a source directory."""
    result = subprocess.run(
        ["git", "-C", str(checkout), "cat-file", "-t", f"{revision}:{source}"],
        text=True,
        capture_output=True,
        check=False,
    )
    return result.returncode == 0 and result.stdout.strip() == "tree"


def extract_directory(
    checkout: Path, revision: str, source: str, destination: Path
) -> None:
    """Extract an upstream directory at a revision."""
    if not source_directory_exists(checkout, revision, source):
        raise VendorError(
            f"upstream source {source!r} is missing at {revision}; "
            "it may have been renamed or removed"
        )
    archive = run("git", "-C", str(checkout), "archive", f"{revision}:{source}")
    destination.mkdir()
    safe_extract(archive, destination)


def read_git_file(checkout: Path, revision: str, source: str) -> bytes:
    """Read one file from an upstream revision."""
    return run("git", "-C", str(checkout), "show", f"{revision}:{source}")


def read_skill_document(skill_directory: Path) -> tuple[Path, str, str]:
    """Read a skill document and locate its YAML frontmatter."""
    skill_file = skill_directory / "SKILL.md"
    try:
        text = skill_file.read_text()
    except FileNotFoundError as error:
        raise VendorError(
            f"vendored directory has no SKILL.md: {skill_directory}"
        ) from error

    match = re.match(r"\A---\n(?P<frontmatter>.*?)\n---\n", text, flags=re.DOTALL)
    if not match:
        raise VendorError(f"SKILL.md has no YAML frontmatter: {skill_file}")
    return skill_file, match.group("frontmatter"), text[match.end() :]


def rename_skill(skill_directory: Path, name: str) -> None:
    """Replace the skill's frontmatter name."""
    skill_file, frontmatter, body = read_skill_document(skill_directory)
    frontmatter, replacements = NAME_FIELD.subn(f"name: {name}", frontmatter)
    if replacements != 1:
        raise VendorError(
            f"expected one name field in {skill_file}, found {replacements}"
        )
    skill_file.write_text(f"---\n{frontmatter}\n---\n{body}")


def validate_skill_name(skill_directory: Path, expected: str) -> None:
    """Require a staged skill to expose its declared local name."""
    skill_file, frontmatter, _ = read_skill_document(skill_directory)
    names = NAME_FIELD.findall(frontmatter)
    if len(names) != 1 or names[0].strip() != expected:
        actual = names[0].strip() if len(names) == 1 else f"{len(names)} name fields"
        raise VendorError(
            f"expected local name {expected!r} in {skill_file}, found {actual!r}"
        )


def read_patch(path: str) -> bytes:
    """Read a declared patch or report its missing path."""
    patch = ROOT / path
    if not patch.is_file():
        raise VendorError(f"patch not found: {patch}")
    return patch.read_bytes()


def apply_patches(skill_directory: Path, patches: list[str]) -> None:
    """Apply declared patches to a staged skill."""
    for patch_path in patches:
        run(
            "patch",
            "--batch",
            "--forward",
            "--no-backup-if-mismatch",
            "-p1",
            "-d",
            str(skill_directory),
            stdin=read_patch(patch_path),
        )


def path_chunks(path: Path, label: str) -> Iterator[bytes]:
    """Yield a managed path's structure and contents in hash order."""
    try:
        root_mode = path.lstat().st_mode
    except FileNotFoundError as error:
        raise VendorError(f"managed output is missing: {path}") from error

    paths = [path]
    if stat.S_ISDIR(root_mode):
        paths.extend(sorted(path.rglob("*")))

    for child in paths:
        mode = child.lstat().st_mode
        relative = child.relative_to(path) if child != path else Path()
        yield label.encode() + b"\0" + relative.as_posix().encode() + b"\0"
        if stat.S_ISLNK(mode):
            yield b"link\0" + str(child.readlink()).encode() + b"\0"
        elif stat.S_ISDIR(mode):
            yield b"dir\0"
        elif stat.S_ISREG(mode):
            yield b"file+x\0" if mode & stat.S_IXUSR else b"file\0"
            yield child.read_bytes()
            yield b"\0"
        else:
            raise VendorError(f"unsupported managed output: {child}")


def hash_outputs(outputs: list[tuple[Path, str]]) -> str:
    """Hash managed paths in order with their destination labels."""
    hasher = hashlib.sha256()
    for path, label in outputs:
        for chunk in path_chunks(path, label):
            hasher.update(chunk)
    return hasher.hexdigest()


def output_hash(name: str, entry: SkillEntry) -> str:
    """Hash every live output managed by a skill entry."""
    outputs = [(skill_destination(name), f"skills/{name}")]
    license_entry = entry.get("license")
    if license_entry:
        destination = license_entry["destination"]
        outputs.append((ROOT / destination, destination))
    return hash_outputs(outputs)


def recipe_hash(entry: SkillEntry, repository: RepositorySpec) -> str:
    """Hash a resolved skill recipe and patch contents."""
    skill_recipe = {
        key: value for key, value in entry.items() if key not in LOCK_FIELDS
    }
    recipe = {"repository": repository, "skill": skill_recipe}
    serialized = json.dumps(recipe, sort_keys=True, separators=(",", ":"))
    hasher = hashlib.sha256(serialized.encode())
    for patch_path in entry.get("patches", []):
        hasher.update(b"\0" + patch_path.encode() + b"\0" + read_patch(patch_path))
    return hasher.hexdigest()


def guard_output(name: str, entry: SkillEntry, *, force: bool) -> None:
    """Refuse to overwrite vendored output that has drifted."""
    expected = entry.get("outputSha256")
    if force or not expected:
        return
    try:
        actual = output_hash(name, entry)
    except VendorError as error:
        raise VendorError(
            f"{name}: cannot verify vendored output; restore it or rerun "
            f"with --force: {error}"
        ) from error
    if actual != expected:
        raise VendorError(
            f"{name}: vendored output drifted; preserve changes as a patch "
            "or rerun with --force"
        )


def check_skill(name: str, entry: SkillEntry, repository: RepositorySpec) -> list[str]:
    """Return drift errors for one vendored skill."""
    errors = []
    try:
        actual_recipe = recipe_hash(entry, repository)
        if entry.get("recipeSha256") != actual_recipe:
            errors.append(f"{name}: manifest or patches changed; run sync")

        actual_output = output_hash(name, entry)
        if entry.get("outputSha256") != actual_output:
            errors.append(
                f"{name}: vendored output drifted; run sync or preserve "
                "changes as a patch"
            )
    except VendorError as error:
        errors.append(f"{name}: {error}")
    return errors


def stage_skill(
    temporary: Path,
    checkout: Path,
    repository: RepositorySpec,
    name: str,
    entry: SkillEntry,
) -> StagedSkill:
    """Build and hash one skill without changing managed outputs."""
    skill_root = temporary / "skills"
    skill_root.mkdir(exist_ok=True)
    staged = skill_root / name
    revision = repository["revision"]
    extract_directory(checkout, revision, entry["source"], staged)
    rename_skill(staged, name)
    apply_patches(staged, entry.get("patches", []))
    validate_skill_name(staged, name)

    outputs = [(staged, f"skills/{name}")]
    license_pair = None
    license_entry = entry.get("license")
    if license_entry:
        license_root = temporary / "licenses"
        license_root.mkdir(exist_ok=True)
        staged_license = license_root / name
        staged_license.write_bytes(
            read_git_file(checkout, revision, license_entry["source"])
        )
        staged_license.chmod(0o644)
        destination = license_entry["destination"]
        license_pair = (staged_license, ROOT / destination)
        outputs.append((staged_license, destination))

    return StagedSkill(
        name=name,
        directory=staged,
        license=license_pair,
        recipe_sha256=recipe_hash(entry, repository),
        output_sha256=hash_outputs(outputs),
    )


def remove_path(path: Path) -> None:
    """Remove a file, link, or directory when it exists."""
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def restore_paths(
    installed: list[Path], moved: list[tuple[Path, Path]], recovery: Path
) -> None:
    """Restore replaced paths or retain their recovery files."""
    try:
        for destination in reversed(installed):
            remove_path(destination)
        for destination, backup in reversed(moved):
            backup.replace(destination)
    except OSError as error:
        raise VendorError(
            f"failed to restore managed outputs; recovery files kept at {recovery}"
        ) from error
    shutil.rmtree(recovery)


def replace_paths(replacements: list[tuple[Path, Path]]) -> None:
    """Replace managed paths and retain recovery files if rollback fails."""
    recovery = Path(tempfile.mkdtemp(prefix=".vendor-skills-recovery-", dir=ROOT))
    moved: list[tuple[Path, Path]] = []
    installed: list[Path] = []
    with ExitStack() as rollback:
        rollback.callback(restore_paths, installed, moved, recovery)
        for index, (staged, destination) in enumerate(replacements):
            destination.parent.mkdir(parents=True, exist_ok=True)
            if destination.exists() or destination.is_symlink():
                backup = recovery / str(index)
                destination.replace(backup)
                moved.append((destination, backup))
            staged.replace(destination)
            installed.append(destination)
        rollback.pop_all()
    shutil.rmtree(recovery)


def commit_repository(
    manifest: Manifest,
    alias: str,
    repository: RepositorySpec,
    staged_skills: list[StagedSkill],
    temporary: Path,
) -> None:
    """Commit staged siblings, their shared pin, and lock hashes together."""
    candidate = copy.deepcopy(manifest)
    candidate["repositories"][alias] = repository
    for staged in staged_skills:
        entry = candidate["skills"][staged.name]
        entry["recipeSha256"] = staged.recipe_sha256
        entry["outputSha256"] = staged.output_sha256

    staged_manifest = temporary / "skills.json"
    staged_manifest.write_text(manifest_contents(candidate))
    staged_manifest.chmod(0o644)

    replacements: list[tuple[Path, Path]] = []
    for staged in staged_skills:
        replacements.append((staged.directory, skill_destination(staged.name)))
        if staged.license:
            replacements.append(staged.license)
    replacements.append((staged_manifest, MANIFEST_PATH))
    replace_paths(replacements)

    manifest.update(candidate)


def guard_skills(skills: SkillSelection, *, force: bool) -> None:
    """Refuse a repository transaction when any selected output drifted."""
    for name, entry in skills:
        guard_output(name, entry, force=force)


def sync_repository(
    manifest: Manifest,
    alias: str,
    repository: RepositorySpec,
    skills: SkillSelection,
) -> None:
    """Stage and commit a repository's selected skills at one revision."""
    checkout = ensure_revision(repository)
    with tempfile.TemporaryDirectory(dir=ROOT) as path:
        temporary = Path(path)
        staged = [
            stage_skill(temporary, checkout, repository, name, entry)
            for name, entry in skills
        ]
        commit_repository(manifest, alias, repository, staged, temporary)


def command_sync(manifest: Manifest, names: list[str], *, force: bool) -> None:
    """Rebuild selected skills at their repositories' pinned revisions."""
    groups = group_skills(selected_skills(manifest, names))
    for alias, skills in groups.items():
        guard_skills(skills, force=force)
        repository = manifest["repositories"][alias]
        sync_repository(manifest, alias, repository, skills)
        for name, _ in skills:
            print(f"synced {name} at {repository['revision'][:12]}")


def command_update(manifest: Manifest, *, force: bool) -> None:
    """Advance every repository and rebuild all of its skills."""
    groups = group_skills(list(manifest["skills"].items()))
    for alias in manifest["repositories"]:
        repository = manifest["repositories"][alias]
        skills = groups[alias]
        guard_skills(skills, force=force)
        old_revision = repository["revision"]
        new_revision = resolve_revision(repository)
        candidate = repository.copy()
        candidate["revision"] = new_revision
        sync_repository(manifest, alias, candidate, skills)
        if new_revision == old_revision:
            print(f"up to date {alias} at {new_revision[:12]}")
        else:
            print(f"updated {alias} {old_revision[:12]} -> {new_revision[:12]}")


def command_check(manifest: Manifest, names: list[str]) -> None:
    """Verify selected vendored skills without using the network."""
    errors = []
    selected = selected_skills(manifest, names)
    for name, entry in selected:
        repository = manifest["repositories"][entry["repository"]]
        skill_errors = check_skill(name, entry, repository)
        errors.extend(skill_errors)
        if not skill_errors:
            print(f"ok {name}")
    if errors:
        raise VendorError("\n".join(errors))


def parse_args() -> Arguments:
    """Parse the vendoring command line."""
    parser = argparse.ArgumentParser(
        description="Vendor third-party skills declared in vendor/skills.json.",
        epilog=CLI_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    sync_parser = subparsers.add_parser(
        "sync",
        help="rebuild skills from pinned revisions",
        description=(
            "Rebuild selected skills at their pinned revisions without advancing "
            "pins. Fetch source data if it is missing from the local cache."
        ),
    )
    sync_parser.add_argument(
        "skills", nargs="*", help="skill names to process; defaults to all"
    )
    sync_parser.add_argument(
        "--force",
        action="store_true",
        help="allow overwriting local changes in managed output",
    )

    update_parser = subparsers.add_parser(
        "update",
        help="update all repositories from their tracking branches",
        description=(
            "Fetch every configured tracking branch, then rebuild and pin all skills "
            "from each repository as one group."
        ),
    )
    update_parser.add_argument(
        "--force",
        action="store_true",
        help="allow overwriting local changes in managed output",
    )

    check_parser = subparsers.add_parser(
        "check",
        help="check vendored skills for drift",
        description=(
            "Verify local recipes and managed outputs against their recorded hashes "
            "without using the network."
        ),
    )
    check_parser.add_argument(
        "skills", nargs="*", help="skill names to process; defaults to all"
    )

    return parser.parse_args(namespace=Arguments())


def main() -> int:
    """Run the requested vendoring command."""
    args = parse_args()
    try:
        manifest = load_manifest()
        match args.command:
            case "sync":
                command_sync(manifest, args.skills, force=args.force)
            case "update":
                command_update(manifest, force=args.force)
            case "check":
                command_check(manifest, args.skills)
    except VendorError as error:
        print(error, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
